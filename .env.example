# Copy this file to .env and fill in your own values.
# `scripts/init.sh` can generate this automatically (recommended) — see README.md.

# System variables
## Replace with the output of `id -u`
UID=1000
## Replace with the output of `id -g`
GID=1000

# ElasticSearch password (shared by TheHive and Cortex index.conf)
elasticsearch_password = '###CHANGEME_ELASTICSEARCH_PASSWORD###'

# Nginx
nginx_server_name = 'localhost'
nginx_ssl_trusted_certificate = ''

# Cortex specific configuration
cortex_docker_job_directory=${PWD}/cortex/cortex-jobs

# Containers versions (see versions.env for the values used in this lab)
cassandra_image_version = '4.1.11'
elasticsearch_image_version = '8.19.15'
thehive_image_version = '5.7.1'
cortex_image_version = '4.0.1'
nginx_image_version = '1.31.1'
