# Secrets (real values) — use dot.env.template / .env.example instead
.env

# Generated config files with real secrets (created by scripts/init.sh from *.template)
thehive/config/secret.conf
thehive/config/index.conf
cortex/config/secret.conf
cortex/config/index.conf

# Runtime data (bind-mounted volumes, regenerated on init/start)
cassandra/data/
cassandra/logs/
elasticsearch/data/
elasticsearch/logs/
thehive/data/
thehive/logs/
cortex/logs/
cortex/cortex-jobs/

# TLS certificates (self-signed or custom, generated by scripts/generate_certs.sh)
certificates/*
!certificates/.gitkeep
nginx/certs/*
!nginx/certs/.gitkeep

# macOS
.DS_Store

# Editor temp files
*.swp
*.swo
*~
